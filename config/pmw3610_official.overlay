#include <dt-bindings/zmk/input_transform.h>

/*
 * A/B test variant: replace only the PMW3610 implementation while preserving
 * the board, ZMK revision, keymap, 400 CPI, orientation, and scroll behavior.
 */
&trackball {
    compatible = "pixart,pmw3610";

    /delete-property/ irq-gpios;
    /delete-property/ cpi;
    /delete-property/ swap-xy;
    /delete-property/ invert-x;
    /delete-property/ invert-y;
    /delete-property/ evt-type;
    /delete-property/ x-input-code;
    /delete-property/ y-input-code;

    motion-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    zephyr,axis-x = <INPUT_REL_X>;
    zephyr,axis-y = <INPUT_REL_Y>;
    res-cpi = <400>;
    smart-mode;
};

/*
 * Hardware test showed that X/Y inversion reverses both pointer directions on
 * this build. Keep only the axis swap required by the sensor orientation.
 */
&trackball_listener {
    input-processors
        = <&zip_xy_transform
            (INPUT_TRANSFORM_XY_SWAP)>
        ;
};

&trackball_scroll_layer {
    input-processors
        = <&zip_xy_transform
            (INPUT_TRANSFORM_XY_SWAP)>
        , <&zip_xy_to_scroll_mapper>
        , <&zip_scroll_scaler 1 70>
        ;
};
