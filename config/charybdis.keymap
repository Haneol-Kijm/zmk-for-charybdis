#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&sk { quick-release; };

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };

        del_word: del_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp BACKSPACE>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "DEL_WORD";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "CUT";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "PASTE";
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "UNDO";
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp Y>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "REDO";
        };
    };

    combos {
        compatible = "zmk,combos";

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <10 1>;
        };

        kor_eng {
            bindings = <&kp F19>;
            key-positions = <11 2>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <12 3>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 11>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <0 1>;
        };

        rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <0 2>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <1 2>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <1 3>;
        };

        lbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        rbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <2 4>;
        };

        lctl {
            bindings = <&kp LCTRL>;
            key-positions = <12 13>;
        };

        lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <12 11>;
        };

        lmet {
            bindings = <&kp LEFT_GUI>;
            key-positions = <12 10>;
        };

        lctl+lalt {
            bindings = <&kp LC(LALT)>;
            key-positions = <12 13>;
        };

        cut {
            bindings = <&cut>;
            key-positions = <20 21>;
        };

        copy {
            bindings = <&copy>;
            key-positions = <21 22>;
        };

        paste {
            bindings = <&paste>;
            key-positions = <22 23>;
        };

        undo {
            bindings = <&undo>;
            key-positions = <22 20>;
        };

        redo {
            bindings = <&redo>;
            key-positions = <23 21>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <11 1>;
        };

        ampers {
            bindings = <&kp AMPERSAND>;
            key-positions = <2 12>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <2 12>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <12 23>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <8 9>;
        };

        apo {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <7 8>;
        };

        quo {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <7 6>;
        };

        rctrl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <16 17>;
        };

        ralt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <17 18>;
        };

        rmet {
            bindings = <&kp RIGHT_META>;
            key-positions = <19 17>;
        };

        k {
            bindings = <&kp V>;
            key-positions = <25 26>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <26 27>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <28 27>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <28 26>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <27 25>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <8 18>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 7>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <6 16>;
        };

        star {
            bindings = <&kp STAR>;
            key-positions = <9 18>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <19 8>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <18 7>;
        };

        bslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <6 17>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <17 26>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp Q        &kp W  &kp F      &kp P      &kp B        &kp J            &kp L      &kp U      &kp Y    &kp SEMI
&mt LSHFT A  &kp R  &kp S      &kp T      &kp G        &kp M            &kp N      &kp E      &kp I    &mt RSHFT O
&kp Z        &kp X  &kp D      &kp C      &kp V        &kp K            &kp H      &kp COMMA  &kp DOT  &tog 5
                    &lt 2 TAB  &lt 1 RET  &kp SPACE    &lt 3 BACKSPACE  &lt 4 DEL
            >;
        };

        NUM {
            bindings = <
&kp BSPC  &kp N7  &kp N8  &kp N9  &trans    &trans  &trans  &trans  &trans  &trans
&kp N0    &kp N4  &kp N5  &kp N6  &trans    &trans  &trans  &trans  &trans  &trans
&trans    &kp N1  &kp N2  &kp N3  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans
            >;
        };

        FUN {
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9  &trans    &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &trans  &trans  &trans  &trans
&kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans  &trans  &trans  &trans
                 &trans  &trans  &trans    &trans  &trans
            >;
        };

        NAV {
            bindings = <
&trans  &trans  &trans     &trans  &trans    &trans  &kp HOME  &kp UP    &kp END    &trans
&trans  &trans  &del_word  &trans  &trans    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans  &trans  &trans     &trans  &trans    &trans  &trans    &trans    &trans     &trans
                &trans     &trans  &trans    &trans  &trans
            >;
        };

        MEDIA {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans
&trans  &trans  &trans  &trans  &trans    &trans  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans            &trans        &trans
                &trans  &trans  &trans    &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans          &msc SCRL_UP    &trans           &trans      &trans  &trans  &trans  &trans  &trans
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans          &trans           &trans      &trans  &trans  &trans  &trans  &trans
                        &mkp MB1        &mkp MB3         &mkp MB2    &trans  &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };
};
